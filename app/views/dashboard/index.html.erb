<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= @title %></title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 2rem; }
    h1 { margin: 0 0 .25rem 0; }
    .muted { color: #666; margin-bottom: 1rem; }
    .row { display: flex; gap: 1rem; align-items: center; margin: 1rem 0; }
    table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    .flash { background: #eefbea; border: 1px solid #bde5a6; padding: .5rem .75rem; margin: .75rem 0; }
    .btn { padding: .5rem .75rem; border: 1px solid #333; background: #fff; cursor: pointer; border-radius: .375rem; }
    .btn-primary { background: #0b57d0; color: #fff; border-color: #0b57d0; }
    .btn-secondary { background: #f6f6f6; color: #111; }
    .btn-danger { background: #a11; color: #fff; border-color: #a11; }
    .badge { padding: .1rem .5rem; border-radius: .5rem; border: 1px solid #ccc; }
    .ok { color: #0a7a2f; border-color: #0a7a2f; }
    .not { color: #a11; border-color: #a11; }
    form { display: inline-block; }
    label { display: block; margin-top: .5rem; }
    input[type="text"], input[type="number"], input[type="date"] { padding: .4rem .5rem; width: 16rem; }
    .section { margin-top: 2rem; }
    details { border: 1px solid #ddd; border-radius: .5rem; padding: .75rem 1rem; background: #fafafa; }
    details > summary { cursor: pointer; font-weight: 600; }
    .status-badge { padding: .15rem .5rem; border-radius: .5rem; font-size: .85rem; }
    .status-active { background: #e6f4ea; color: #1e8e3e; }
    .status-expired { background: #fce8e6; color: #c5221f; }
  </style>
</head>
<body>
  <h1><%= @title %></h1>
  <div class="muted"><%= @subtitle %></div>

  <% if flash[:notice] %>
    <div class="flash"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="flash" style="background:#ffdede;"><%= flash[:alert] %></div>
  <% end %>

<div class="row">
  <% if @gmail_connected %>
    <span class="badge ok">Connected</span>
    <%= button_to "Disconnect Gmail", "/disconnect_gmail", method: :post, class: "btn btn-danger" %>
  <% else %>
    <%= button_to "Connect Gmail", "/auth/google_oauth2", method: :post, class: "btn btn-primary", data: { turbo: false } %>
    <span class="badge not">Not Connected</span>
  <% end %>
</div>


  <details class="section">
    <summary>Add a product warranty</summary>
    <div style="margin-top:.75rem;">
      <form action="/upload" method="post">
        <%= csrf_meta_tags %>
        <label>Product
          <input type="text" name="product" required />
        </label>
        <label>Merchant (optional)
          <input type="text" name="merchant" placeholder="Amazon (default)" />
        </label>
        <label>Purchase Date
          <input type="date" name="purchase_date" value="<%= Date.today.strftime('%Y-%m-%d') %>" />
        </label>
        <label>Warranty Length (months)
          <input type="number" name="warranty_length" value="12" min="0" />
        </label>
        <button type="submit" class="btn btn-secondary">Add warranty</button>
      </form>
    </div>
  </details>

  <h3>Warranties</h3>
  <table aria-label="warranties">
    <thead>
      <tr>
        <th>Product</th><th>Merchant</th><th>Purchase Date</th><th>Warranty (months)</th><th>Expires</th><th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% if @warranties.empty? %>
        <tr><td colspan="5">No warranties yet.</td></tr>
      <% else %>
        <% @warranties.each do |w| %>
          <tr>
            <td><%= w.product_name %></td>
            <td><%= w.merchant %></td>
            <td><%= w.purchase_date.strftime("%Y-%m-%d") %></td>
            <td><%= w.warranty_months %></td>
            <td><%= w.expiry_date&.strftime("%Y-%m-%d") || '-' %></td>
            <td>
              <% if w.expiry_date && w.expiry_date >= Date.today %>
                <span class="status-badge status-active">Active</span>
              <% else %>
                <span class="status-badge status-expired">Expired</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</body>
</html>
